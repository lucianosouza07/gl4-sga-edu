# ==============================================================================
# GL4 SGA-EDU — Modelo de Variáveis de Ambiente (.env.example)
#
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Globais do Ambiente
# ------------------------------------------------------------------------------
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 2. Backend (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Banco de Dados (SQLAlchemy)
DATABASE_URL="sqlite:///./sga_edu.db"
SQL_ECHO=False

# Segurança & Autenticação JWT
JWT_SECRET_KEY="chave_secreta_padrao_para_dev_gl4_sga_edu_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Administrador Padrão (Seed Inicial)
DEFAULT_ADMIN_NAME="Administrador do Sistema"
DEFAULT_ADMIN_EMAIL="admin@gl4.edu"
DEFAULT_ADMIN_PASSWORD="admin123"

# Controle de Origem CORS (Lista separada por vírgula e Regex)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://gl4-sga-edu.luis-carvalho.online"
CORS_ORIGIN_REGEX="^https?://(localhost|127\.0\.0\.1|.*\.luis-carvalho\.online)(:\d+)?$"

# ------------------------------------------------------------------------------
# 3. Frontend (React / Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_PORT=5173

# Rota base para chamadas da API no frontend (padrão: /api/v1 para proxy reverso local)
VITE_API_URL="/api/v1"

# Endereço alvo do proxy reverso do Vite dev server
VITE_PROXY_TARGET="http://127.0.0.1:8000"

# Hosts autorizados para o servidor de desenvolvimento do Vite (separados por vírgula)
VITE_ALLOWED_HOSTS="gl4-sga-edu.luis-carvalho.online,localhost,127.0.0.1"
